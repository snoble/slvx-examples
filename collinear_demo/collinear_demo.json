{
  "schema": "slvs-json/1",
  "units": "mm",
  "parameters": {
    "spacing": 25
  },
  "entities": [
    {
      "type": "point",
      "id": "anchor",
      "at": [0, 0, 0]
    },
    {
      "type": "point",
      "id": "p1",
      "at": [25, 5, 0]
    },
    {
      "type": "point",
      "id": "p2",
      "at": [50, -3, 0]
    },
    {
      "type": "point",
      "id": "p3",
      "at": [75, 8, 0]
    },
    {
      "type": "point",
      "id": "p4",
      "at": [100, -2, 0]
    },
    {
      "type": "line",
      "id": "segment1",
      "p1": "anchor",
      "p2": "p1"
    },
    {
      "type": "line",
      "id": "segment2",
      "p1": "p1",
      "p2": "p2"
    },
    {
      "type": "line",
      "id": "segment3",
      "p1": "p2",
      "p2": "p3"
    },
    {
      "type": "line",
      "id": "segment4",
      "p1": "p3",
      "p2": "p4"
    }
  ],
  "constraints": [
    {
      "type": "fixed",
      "entity": "anchor"
    },
    {
      "type": "collinear",
      "points": ["anchor", "p1", "p2", "p3", "p4"]
    },
    {
      "type": "distance",
      "between": ["anchor", "p1"],
      "value": "$spacing"
    },
    {
      "type": "distance",
      "between": ["p1", "p2"],
      "value": "$spacing"
    },
    {
      "type": "distance",
      "between": ["p2", "p3"],
      "value": "$spacing"
    },
    {
      "type": "distance",
      "between": ["p3", "p4"],
      "value": "$spacing"
    }
  ]
}
